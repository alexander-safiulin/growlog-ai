# Copy to .env (gitignored). Next.js also reads .env.local if it is present.
# `pnpm db:push` reads GROWLOG_DB_PASSWORD from .env only.
# Do not put real keys or passwords in this file.

# Self-hosted Supabase (Coolify stack jvxox6algazptjelglcjmyez).
# Public API origin. Alias: supabase-growlog.staging.handlerbos.com
NEXT_PUBLIC_SUPABASE_URL=https://supabase.growlog.ai
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google, Ethereum, and Solana are enabled on the Supabase Auth container.
# See docs/setup/supabase-runbook.md. Do not put provider secrets here.

# Canonical web origin for hreflang and share links.
# Set the public Coolify origin in production. There is no VERCEL_URL fallback.
# Empty falls back to http://localhost:3000 in local development.
NEXT_PUBLIC_SITE_URL=

OPENAI_API_KEY=

# Optional shared secret for POST /api/sensors/ingest (or set ingest_token per device).
SENSOR_INGEST_SECRET=

# Tuya cloud project linked to SmartLife. Server only. Western America for this farm.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_API_BASE=https://openapi.tuyaus.com

# Postgres password for `pnpm db:push` only. Never commit a real value.
GROWLOG_DB_PASSWORD=
