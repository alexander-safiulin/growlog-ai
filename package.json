{
  "name": "growlog-ai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev",
    "dev:mobile": "pnpm --filter @growlog/mobile start",
    "build": "next build",
    "start": "next start",
    "lint": "eslint packages/nutrient-calc && pnpm lint:app",
    "lint:web": "next lint",
    "typecheck": "tsc -p packages/nutrient-calc/tsconfig.json --noEmit && pnpm typecheck:web && pnpm --filter @growlog/mobile typecheck",
    "test:mobile": "pnpm --filter @growlog/mobile test",
    "worker": "tsx scripts/background-worker.ts",
    "test": "vitest run && pnpm test:migrations",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:migrations": "bash scripts/migration-test/check-immutable-migrations.sh && bash scripts/migration-test/run-catalog-incremental-equivalence.sh && vitest run tests/integration/adr014-migrations-ephemeral.test.ts && MIGRATION_TEST_USE_DOCKER=auto vitest run tests/integration/grow-cycle-feeding-rpc-postgres.test.ts tests/integration/grow-cycle-harvest-postgres.test.ts tests/integration/farm-invitations-postgres.test.ts",
    "check-i18n": "tsx scripts/check-i18n.ts",
    "build-help-locales": "node scripts/build-help-locales.mjs",
    "brand:icons": "tsx scripts/brand/generate-app-icons.ts",
    "test:integration": "vitest run tests/integration",
    "test:integration:watch": "vitest tests/integration",
    "db:push": "bash scripts/db-push.sh",
    "nutrient:build-catalog": "tsx scripts/nutrient-import/build-adr014-catalog.ts",
    "nutrient:build-product-names": "tsx scripts/build-product-display-names.ts",
    "nutrient:build-p4-migration": "tsx scripts/nutrient-import/build-p4-manufacturer-migration.ts",
    "nutrient:build-p5-migration": "tsx scripts/nutrient-import/build-p5-manufacturer-migration.ts",
    "nutrient:list-source-urls": "tsx scripts/nutrient-import/list-catalog-source-urls.ts",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "lint:app": "eslint pages/nutrient components/nutrient lib/nutrient --max-warnings 0"
  },
  "dependencies": {
    "@growlog/domain": "workspace:*",
    "@growlog/nutrient-calc": "workspace:*",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.69.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "katex": "0.16.22",
    "lucide-react": "^0.268.0",
    "next": "^15.2.4",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "openai": "^4.104.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.5.9",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "pg": "^8.14.1",
    "postcss": "^8.5.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "to-ico": "^1.1.5",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.0"
  }
}
