{
  "expo": {
    "name": "Growlog",
    "slug": "growlog-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "growlog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.growlog.mobile",
      "appleTeamId": "KZP72KD4LK",
      "infoPlist": {
        "NSCameraUsageDescription": "Growlog uses the camera for grow photos.",
        "NSMicrophoneUsageDescription": "Growlog records voice logs.",
        "NSPhotoLibraryUsageDescription": "Growlog saves and uploads grow photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#536C4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "ai.growlog.mobile",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#536C4A"
        }
      ],
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Growlog to upload grow photos.",
          "cameraPermission": "Allow Growlog to capture grow photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#536C4A"
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.119280915837-85ef2dqu0ogenkpg3nslvtqhlg1m7iuh"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
