EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Public Google OAuth client IDs for the in-app account picker. Not secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Web API (voice transcribe, assistant, SOP materialize). Baked into release APK/IPA.
# Testers & production: https://growlog.ai (same origin as NEXT_PUBLIC_SITE_URL).
# Local dev (simulator): http://127.0.0.1:3000 with `pnpm dev` in repo root.
# Physical device on LAN: http://<mac-hostname-or-ip>:3000 — not localhost.
EXPO_PUBLIC_API_BASE_URL=https://growlog.ai
# Debug builds load JS from Metro: run `pnpm dev` in apps/mobile (same Wi‑Fi), then Reload JS on the phone.
# Optional: Expo push API access token (server-side EXPO_ACCESS_TOKEN on Next.js)
